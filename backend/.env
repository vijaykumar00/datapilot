# DataPilot Environment Configuration
# ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: ollama | gemini | openai | claude
LLM_PROVIDER=gemini

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyAgFIOEHKllHEq7CZrqvDB57hqcUs-XsQ4
GEMINI_MODEL=models/gemini-2.5-flash

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local) — https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=datapilot-secret-jwt-key-2026-sprint-2

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Set this in production or user API keys will be lost on server restart
ENCRYPTION_KEY=JyIa1ZvSADr2YJV8XdEnGqqHnJlD7nPPCH8bWUnAuxI=

# ─────────────────────────────────────────────────────────────
# Email (SMTP) — leave blank to use console/dev mode
# ─────────────────────────────────────────────────────────────
# For Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
# For Mailgun/SendGrid/Resend: check their SMTP docs
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@datapilot.ai
SMTP_FROM_NAME=DataPilot
SMTP_USE_TLS=true

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
DEBUG=false
GUEST_SESSION_TTL_HOURS=24
