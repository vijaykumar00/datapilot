# DataPilot backend environment
# Copy to backend/.env for local development or map these values in your deployment platform.

APP_ENV=development
DEBUG=false

# Networking
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Local default uses SQLite at backend/uploads/datapilot.db.
# Production should use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://datapilot:change-me@postgres:5432/datapilot
DATABASE_URL=

# Redis-backed shared rate limiting
RATE_LIMITER_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
# Must be false in production (validated at startup).
RATE_LIMITER_FAIL_OPEN=true
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_AUTH_SIGNUP_MAX_REQUESTS=5
RATE_LIMIT_AUTH_OAUTH_MAX_REQUESTS=20
RATE_LIMIT_AUTH_OTP_MAX_REQUESTS=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_RESET_MAX_REQUESTS=5
RATE_LIMIT_GUEST_SESSION_WINDOW_SECONDS=3600
RATE_LIMIT_GUEST_SESSION_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX_REQUESTS=60
RATE_LIMIT_REPORT_WINDOW_SECONDS=3600
RATE_LIMIT_REPORT_MAX_REQUESTS=30
RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600
RATE_LIMIT_EXPORT_MAX_REQUESTS=30
RATE_LIMIT_BILLING_WINDOW_SECONDS=60
RATE_LIMIT_BILLING_MAX_REQUESTS=60
RATE_LIMIT_API_KEY_WINDOW_SECONDS=300
RATE_LIMIT_API_KEY_MAX_REQUESTS=30
# Production must set RATE_LIMITER_BACKEND=redis and a non-localhost Redis URL.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

# Storage
# Local is for development. Production should use STORAGE_PROVIDER=s3 with AWS S3,
# Cloudflare R2, or MinIO-compatible object storage.
STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_PRESIGN_EXPIRES=900

# Upload/file processing safety
FILE_PARSE_TIMEOUT_SECONDS=30
MAX_DATASET_ROWS=250000
MAX_DATASET_COLUMNS=500
# rows x columns cap; memory scales with cells (see docs/production-operations.md)
MAX_DATASET_CELLS=20000000
MAX_EXCEL_SHEETS=25
MAX_WORKBOOK_DECOMPRESSED_BYTES=209715200

# Security
# Required in every environment. Generate with:
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
# Persistent Fernet key for stored user API keys (required in production; never rotate
# without re-encrypting). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated emails allowed to manage plans/grants (platform operators, not workspace owners).
PLATFORM_ADMIN_EMAILS=
# Set true when serving over HTTPS outside APP_ENV=production so the refresh cookie is Secure.
COOKIE_SECURE=false
REFRESH_REUSE_GRACE_SECONDS=20

# Background jobs
# inline = run in the API process (development/tests only); worker = durable queue processed by
# `python worker.py` (required in production; run >= 2 workers for availability).
JOB_EXECUTION_MODE=inline
WORKER_CONCURRENCY=2
WORKER_METRICS_PORT=
JOB_VISIBILITY_TIMEOUT_SECONDS=300
JOB_RETENTION_DAYS=7
# Seconds the API waits for a job before answering 202 + job_id (client polls /jobs/{id}).
UPLOAD_WAIT_SECONDS=25
EXPORT_WAIT_SECONDS=30
REPORT_WAIT_SECONDS=90

# Database
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Development convenience only; production runs `alembic upgrade head` as a deploy step.
RUN_MIGRATIONS_ON_STARTUP=true

# Query engine / datasets
QUERY_MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
EXPORT_MAX_ROWS=1000000
MAX_UPLOAD_BYTES=52428800
DATASET_CACHE_MAX_BYTES=536870912
DATASET_UNDO_DEPTH=10
AGENT_TIMEOUT_SECONDS=45

# Email (verification, password reset). Required in production; without SMTP_HOST,
# development prints emails to the console and production refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DataPilot
FRONTEND_URL=http://localhost:5173

# Guest sessions
GUEST_SESSION_TTL_HOURS=24
GUEST_DATA_RETENTION_HOURS=72

# Observability
LOG_FORMAT=text
LOG_LEVEL=INFO
# Bearer token required to scrape /metrics (metrics are disabled in production without it).
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=

# Social login and phone OTP
# OAuth redirect origins must match the frontend origins that receive /auth/oauth/{provider}/callback.
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
PHONE_OTP_ENABLED=true
PHONE_OTP_DEV_MODE=true
# In production, set PHONE_OTP_DEV_MODE=false and provide a delivery webhook.
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# LLM providers
# Platform default provider (required in production): gemini | openai | claude | ollama.
# Users may choose their own provider/key in Settings; keys are stored encrypted per user.
LLM_PROVIDER=gemini
LLM_MAX_CONCURRENCY=8
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Stripe billing adapter
STRIPE_BILLING_ENABLED=true
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRODUCT_TEAM=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
