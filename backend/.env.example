# DataPilot backend environment
# Copy to backend/.env for local development or map these values in your deployment platform.

APP_ENV=development
DEBUG=false

# Networking
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Local default uses SQLite at backend/uploads/datapilot.db.
# Production should use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg2://datapilot:change-me@postgres:5432/datapilot
DATABASE_URL=

# Security
# Required in every environment. Generate with:
# python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=
ENCRYPTION_KEY=

# LLM providers
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Billing placeholders
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
